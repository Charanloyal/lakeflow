{
  "name": "lakeflow-postgres-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium_user",
    "database.password": "debezium_password",
    "database.dbname": "platform_db",
    "database.server.name": "lakeflow",
    "topic.prefix": "lakeflow",
    "table.include.list": "platform.customers,platform.products,platform.orders,platform.order_items",
    "slot.name": "lakeflow_cdc_slot",
    "slot.drop.on.stop": "false",
    "publication.name": "platform_cdc_publication",
    "publication.autocreate.mode": "filtered",
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "5000",
    "heartbeat.topics.prefix": "__debezium-heartbeat",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "none",
    "errors.retry.timeout": "300",
    "errors.retry.delay.initial.ms": "1000",
    "errors.retry.delay.max.ms": "10000"
  }
}
