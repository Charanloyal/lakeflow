# LakeFlow local configuration template. `make bootstrap` copies it to .env (git-ignored) and replaces every
# __GENERATE__ with a random value. `local-only-*` values are fixed demo credentials for a stack that binds
# to 127.0.0.1 only. Never reuse them. docs/security.md lists the production replacements.
COMPOSE_PROJECT_NAME=lakeflow
LAKEFLOW_PROFILE=16gb

# PostgreSQL (source OLTP + Iceberg catalog DB + control DB + Airflow metadata DB in one local instance)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
LAKEFLOW_APP_PASSWORD=__GENERATE__
DEBEZIUM_PASSWORD=__GENERATE__
ICEBERG_CATALOG_PASSWORD=__GENERATE__
CONTROL_DB_PASSWORD=__GENERATE__
AIRFLOW_DB_PASSWORD=__GENERATE__
TRINO_PG_PASSWORD=__GENERATE__

# Object storage
MINIO_ROOT_USER=lakeflow
MINIO_ROOT_PASSWORD=__GENERATE__

# Kafka KRaft cluster id (not a secret; base64url of 16 bytes)
KAFKA_CLUSTER_ID=bGFrZWZsb3ctbG9jYWwtMQ

# Pipeline
LAKEFLOW_PII_HMAC_KEY=__GENERATE__
ALLOWED_LATENESS_SECONDS=300

# Control plane (HTTP Basic / session login). Admin can mutate data and run Recovery Lab actions.
LAKEFLOW_ADMIN_USER=admin
LAKEFLOW_ADMIN_PASSWORD=local-only-admin
LAKEFLOW_VIEWER_USER=viewer
LAKEFLOW_VIEWER_PASSWORD=local-only-viewer
LAKEFLOW_SESSION_SECRET=__GENERATE__
LAKEFLOW_RECOVERY_LAB_ENABLED=true
LAKEFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional services (16gb profile)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local-only-airflow
AIRFLOW_FERNET_KEY=__GENERATE__
AIRFLOW_SECRET_KEY=__GENERATE__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-grafana
