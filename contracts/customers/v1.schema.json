{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charanloyal/lakeflow/contracts/customers/v1.schema.json",
  "title": "shop.customers row image (v1)",
  "description": "Customer dimension used for referential-integrity checks. Direct PII is hashed or dropped before it reaches the lakehouse.",
  "type": "object",
  "x-lakeflow": {
    "contract": "customers",
    "version": 1,
    "status": "current",
    "owner": { "team": "customer-identity", "contact": "identity-data@example.com" },
    "source": { "system": "postgresql", "database": "lakeflow", "table": "shop.customers", "topic": "lakeflow.shop.customers" },
    "primary_key": ["customer_id"],
    "compatibility": "BACKWARD_TRANSITIVE",
    "classification": "confidential",
    "freshness_sla": { "p95_seconds": 120, "max_seconds": 600, "measured_as": "silver commit time - source commit time" },
    "target_table": "silver.customers"
  },
  "required": ["customer_id", "email", "full_name", "country", "created_at", "updated_at"],
  "properties": {
    "customer_id": { "type": "string", "format": "uuid", "x-pii": "pseudonymous" },
    "email": { "type": "string", "format": "email", "maxLength": 254, "x-pii": "direct", "x-pii-handling": "hash" },
    "full_name": { "type": "string", "minLength": 1, "maxLength": 200, "x-pii": "direct", "x-pii-handling": "drop" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$", "x-pii": "none" },
    "created_at": { "type": "string", "format": "date-time", "x-pii": "none" },
    "updated_at": { "type": "string", "format": "date-time", "x-pii": "none" }
  }
}
