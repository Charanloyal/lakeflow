{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charanloyal/lakeflow/contracts/orders/v2.schema.json",
  "title": "shop.orders row image (v2)",
  "description": "Adds the optional `channel` column (migration platform/postgres/migrations/001_orders_channel.sql). v1 records remain valid.",
  "type": "object",
  "x-lakeflow": {
    "contract": "orders",
    "version": 2,
    "status": "current",
    "owner": { "team": "commerce-platform", "contact": "commerce-data@example.com" },
    "source": { "system": "postgresql", "database": "lakeflow", "table": "shop.orders", "topic": "lakeflow.shop.orders" },
    "primary_key": ["order_id"],
    "compatibility": "BACKWARD_TRANSITIVE",
    "classification": "internal",
    "freshness_sla": { "p95_seconds": 60, "max_seconds": 300, "measured_as": "silver commit time - source commit time" },
    "target_table": "silver.orders",
    "references": [{ "field": "customer_id", "contract": "customers", "target_field": "customer_id", "grace_seconds": 300 }]
  },
  "required": ["order_id", "customer_id", "status", "amount", "currency", "created_at", "updated_at"],
  "properties": {
    "order_id": { "type": "string", "format": "uuid", "x-pii": "none" },
    "customer_id": { "type": "string", "format": "uuid", "x-pii": "pseudonymous" },
    "status": { "type": "string", "enum": ["PENDING", "PAID", "SHIPPED", "DELIVERED", "CANCELLED"], "x-pii": "none" },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
      "x-decimal": { "precision": 12, "scale": 2 },
      "description": "numeric(12,2) serialized by Debezium decimal.handling.mode=string; must be >= 0",
      "x-pii": "none"
    },
    "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "INR"], "x-pii": "none" },
    "channel": { "type": ["string", "null"], "enum": ["web", "mobile", "store", null], "x-pii": "none" },
    "created_at": { "type": "string", "format": "date-time", "x-pii": "none" },
    "updated_at": { "type": "string", "format": "date-time", "x-pii": "none" }
  }
}
