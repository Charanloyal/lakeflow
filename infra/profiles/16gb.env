# 16 GB laptop / CI runner profile: core path + Prometheus/Grafana + Airflow (~11 GB of container limits).
COMPOSE_PROFILES=observability,maintenance
POSTGRES_MEM=512m
POSTGRES_SHARED_BUFFERS=128MB
KAFKA_HEAP=512m
KAFKA_MEM=1g
CONNECT_HEAP=512m
CONNECT_MEM=1g
MINIO_MEM=512m
ICEBERG_REST_HEAP=256m
ICEBERG_REST_MEM=512m
SPARK_DRIVER_MEMORY=1500m
SPARK_MEM=2560m
SPARK_LOCAL_CORES=2
SPARK_CPUS=2
TRINO_MEM=2g
API_MEM=512m
AIRFLOW_MEM=1536m
TRIGGER_INTERVAL_SECONDS=5
MAX_OFFSETS_PER_TRIGGER=20000
