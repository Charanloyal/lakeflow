# 8 GB laptop profile: core CDC path + UI only (~5 GB of container limits).
# Observability and Airflow are off; enable them one at a time with COMPOSE_PROFILES if you have headroom.
COMPOSE_PROFILES=
POSTGRES_MEM=256m
POSTGRES_SHARED_BUFFERS=64MB
KAFKA_HEAP=384m
KAFKA_MEM=640m
CONNECT_HEAP=384m
CONNECT_MEM=704m
MINIO_MEM=256m
ICEBERG_REST_HEAP=192m
ICEBERG_REST_MEM=320m
SPARK_DRIVER_MEMORY=900m
SPARK_MEM=1400m
SPARK_LOCAL_CORES=2
SPARK_CPUS=2
TRINO_MEM=1200m
API_MEM=256m
TRIGGER_INTERVAL_SECONDS=5
MAX_OFFSETS_PER_TRIGGER=10000
