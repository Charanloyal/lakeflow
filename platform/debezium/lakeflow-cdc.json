{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
  "database.dbname": "lakeflow",
  "topic.prefix": "lakeflow",
  "table.include.list": "shop.orders,shop.customers,lakeflow_ops.debezium_heartbeat,lakeflow_ops.debezium_signal",
  "publication.name": "lakeflow_cdc",
  "publication.autocreate.mode": "disabled",
  "slot.name": "lakeflow_cdc",
  "slot.drop.on.stop": "false",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "tombstones.on.delete": "true",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "UPDATE lakeflow_ops.debezium_heartbeat SET ts = now() WHERE id = 1",
  "signal.enabled.channels": "source",
  "signal.data.collection": "lakeflow_ops.debezium_signal",
  "incremental.snapshot.chunk.size": "1024",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "errors.max.retries": "-1",
  "slot.max.retries": "10",
  "slot.retry.delay.ms": "5000"
}
